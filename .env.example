# =============================================================================
# Messenger-Native SaaS starter — environment variables
# =============================================================================
# Copy to `.env` and fill in. The core bot needs only the REQUIRED block; every
# OPTIONAL integration degrades gracefully when its variables are absent (the AI
# layer falls back to a deterministic stub, billing/analytics become no-ops).
#
# `.env` is gitignored. Never commit real secrets.
# -----------------------------------------------------------------------------

# === REQUIRED ===============================================================

# Supabase project connection. For deployed Edge Functions these two are injected
# automatically by the platform. Set them locally for `supabase functions serve`
# (the values are printed by `supabase start`).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:your-bot-token

# A random string you invent. You pass the SAME value to Telegram's setWebhook
# (secret_token) and the function rejects any webhook call that doesn't match it.
# Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# === OPTIONAL: bot identity =================================================
# Bot @username (without @). Only used to build Stripe return URLs back into the
# chat. Safe to leave blank.
TELEGRAM_BOT_USERNAME=

# === OPTIONAL: trial tuning =================================================
# Length of the free trial in days. Defaults to 14 if unset.
TRIAL_DAYS=14

# === OPTIONAL: AI personalization (Gemini) ==================================
# Without GEMINI_API_KEY the bot uses a deterministic stub composer, so it works
# end-to-end with no AI account. Add a key to personalize the first nudge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# === OPTIONAL: billing (Stripe) =============================================
# Without these, /upgrade replies "billing not configured" and the stripe-webhook
# function stays inert. This is a skeleton in v1 — see docs/billing-and-ai.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# === OPTIONAL: product analytics (PostHog) ==================================
# Without POSTHOG_API_KEY, event tracking is a no-op (Postgres `events` still
# records the funnel). POSTHOG_HOST defaults to the EU cloud endpoint.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# === OPTIONAL: error tracking (Sentry) ======================================
# Without SENTRY_DSN, error reporting is a no-op.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
